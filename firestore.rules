rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    // Uses trusted Firebase Auth ID Token claim for email verification
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isApprovedAgent() {
      return isAuthenticated() &&
             isEmailVerified() &&
             getUserData().role == 'AGENT' &&
             getUserData().approvalStatus == 'APPROVED';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Public signup can create only an unapproved seeker/agent profile.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['SEEKER', 'AGENT'] &&
        request.resource.data.approvalStatus == 'PENDING' &&
        request.resource.data.isAgentApproved == false &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('reviewedBy', '') == '' &&
        request.resource.data.get('reviewedAt', '') == '' &&
        request.resource.data.get('rejectionReason', '') == '';
      // Non-admins cannot modify role, approvalStatus, isAgentApproved, or moderation audit fields
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'role', 'isVerified', 'isAgentApproved', 'approvalStatus', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
      );
      allow delete: if isAdmin();

      // Recipient-only User Notifications Subcollection
      match /notifications/{notificationId} {
        // Reads and deletes strictly restricted to the intended recipient
        allow read, delete: if isOwner(userId);

        // Recipient can ONLY update the isRead field; content and metadata are immutable
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool;

        // Creation authorized only for admins or verified relationship events
        allow create: if isAuthenticated() &&
          request.resource.data.userId == userId &&
          request.resource.data.isRead == false &&
          (
            isAdmin() ||
            (
              // Message Notification: sender must be participant in referenced conversation
              request.resource.data.type == 'MESSAGE' &&
              'conversationId' in request.resource.data &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
            ) ||
            (
              // Viewing Notification: sender must be requester or property owner
              request.resource.data.type == 'VIEWING' &&
              'senderId' in request.resource.data &&
              request.auth.uid == request.resource.data.senderId
            )
          );
      }
    }

    // Properties Collection
    match /properties/{propertyId} {
      // Public browsing allowed only for VERIFIED & AVAILABLE properties
      allow read: if resource.data.status == 'AVAILABLE' && resource.data.verificationStatus == 'VERIFIED'
                  || isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());

      // New agent listings MUST start as DRAFT or PENDING review and cannot grant featured status
      allow create: if isAdmin() || (
        isApprovedAgent() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.status == 'DRAFT' || request.resource.data.status == 'PENDING') &&
        request.resource.data.verificationStatus == 'PENDING' &&
        (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false)
      );

      // Agents cannot edit another agent's property, change ownerId, bypass suspension, or grant verification/featured status
      allow update: if isAdmin() || (
        isApprovedAgent() &&
        request.auth.uid == resource.data.ownerId &&
        resource.data.status != 'SUSPENDED' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerId', 'verificationStatus', 'isFeatured', 'rejectionReason'
        ])
      );

      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.ownerId);
    }

    // Conversations Collection (Participant-only access)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        ) && request.resource.data.senderId == request.auth.uid && request.resource.data.text.size() > 0;
      }
    }
  }
}
